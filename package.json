{
  "name": "jellyfin-watchlist-workspace",
  "version": "1.0.0",
  "description": "Development workspace for Jellyfin Watchlist API and Web projects",
  "private": true,
  "scripts": {
    "install": "npm run install:api && npm run install:web",
    "install:api": "cd JellyfinWatchlist.Api && npm install",
    "install:web": "cd JellyfinWatchlist.Web && npm install",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd JellyfinWatchlist.Api && npm run start:dev",
    "dev:web": "cd JellyfinWatchlist.Web && npm start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.2"
  }
}
